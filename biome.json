{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!openspec",
      "!.claude",
      "!openapi",
      "!src/shared/api/schema.d.ts",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "message": "Import a feature only through its entry point (@/features/<name>); its internals are private."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/**", "!src/shared/**/*.test.ts", "!src/shared/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import a feature only through its entry point (@/features/<name>); its internals are private."
                  },
                  {
                    "group": ["@/features/**", "@/app/**"],
                    "message": "Shared code cannot depend on features or routes."
                  },
                  {
                    "group": ["@tests/**"],
                    "message": "Test fixtures are for tests only."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**", "!src/features/**/*.test.ts", "!src/features/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import a feature only through its entry point (@/features/<name>); its internals are private."
                  },
                  {
                    "group": ["@/app/**"],
                    "message": "Features cannot depend on routes; use @/shared."
                  },
                  {
                    "group": ["@tests/**"],
                    "message": "Test fixtures are for tests only."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
